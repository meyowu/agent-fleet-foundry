{
  "$defs": {
    "SourceEntry": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "100644",
            "100755"
          ],
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "mode",
        "sha256"
      ],
      "title": "SourceEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "commit_sha": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Commit Sha",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SourceEntry"
      },
      "maxItems": 4096,
      "title": "Entries",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "commit_sha",
    "entries"
  ],
  "title": "CommittedSource",
  "type": "object"
}
