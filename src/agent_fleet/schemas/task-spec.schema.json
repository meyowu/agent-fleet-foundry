{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "description": "Stable identifier for one requested task outcome.",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "description": {
          "description": "Observable task outcome, not a delivery-evidence category copied from required_evidence. For code changes, describe requested behavior that admitted independent checks can support; preserve requested scope and report unsupported proof rather than invent it.",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "description"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "CommandSpec": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Argv",
          "type": "array"
        },
        "command_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Command Id",
          "type": "string"
        },
        "environment": {
          "maxProperties": 32,
          "patternProperties": {
            "^[A-Z][A-Z0-9_]{0,63}$": {
              "maxLength": 4096,
              "type": "string"
            }
          },
          "title": "Environment",
          "type": "object"
        },
        "executable": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9._+-]+|\\./[A-Za-z0-9._+-]+)$",
          "title": "Executable",
          "type": "string"
        },
        "logical_cwd": {
          "default": ".",
          "maxLength": 4096,
          "minLength": 1,
          "title": "Logical Cwd",
          "type": "string"
        },
        "max_output_bytes": {
          "default": 64000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "network_requirement": {
          "default": "none",
          "enum": [
            "none",
            "required"
          ],
          "title": "Network Requirement",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "command_id",
        "executable"
      ],
      "title": "CommandSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {
        "$ref": "#/$defs/AcceptanceCriterion"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "allowed_paths": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Paths",
      "type": "array"
    },
    "base_revision": {
      "title": "Base Revision",
      "type": "string"
    },
    "change_kind": {
      "default": "code_change",
      "enum": [
        "read_only",
        "code_change"
      ],
      "title": "Change Kind",
      "type": "string"
    },
    "config_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Snapshot Hash",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "forbidden_paths": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Paths",
      "type": "array"
    },
    "max_repair_iterations": {
      "maximum": 5,
      "minimum": 0,
      "title": "Max Repair Iterations",
      "type": "integer"
    },
    "normalized_goal": {
      "title": "Normalized Goal",
      "type": "string"
    },
    "original_goal": {
      "title": "Original Goal",
      "type": "string"
    },
    "required_evidence": {
      "items": {
        "enum": [
          "canonical_patch",
          "command_evidence",
          "control_plane_plan",
          "independent_verifier_verdict"
        ],
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Required Evidence",
      "type": "array"
    },
    "required_verification_command_ids": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Required Verification Command Ids",
      "type": "array"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^task_[0-9a-f]{32}$",
      "title": "Task Id",
      "type": "string"
    },
    "verification_commands": {
      "items": {
        "$ref": "#/$defs/CommandSpec"
      },
      "maxItems": 32,
      "title": "Verification Commands",
      "type": "array"
    },
    "workflow": {
      "default": "code-change",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Workflow",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "run_id",
    "original_goal",
    "normalized_goal",
    "base_revision",
    "allowed_paths",
    "forbidden_paths",
    "acceptance_criteria",
    "required_evidence",
    "max_repair_iterations",
    "config_snapshot_hash",
    "created_at"
  ],
  "title": "TaskSpec",
  "type": "object"
}
