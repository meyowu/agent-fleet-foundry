{
  "$defs": {
    "CommandEvidence": {
      "additionalProperties": false,
      "properties": {
        "agent_instance_id": {
          "pattern": "^agent_[0-9a-f]{32}$",
          "title": "Agent Instance Id",
          "type": "string"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "candidate_patch_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Patch Sha256"
        },
        "command_id": {
          "default": "legacy-verification",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Command Id",
          "type": "string"
        },
        "command_spec_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Spec Sha256"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "config_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Snapshot Sha256",
          "type": "string"
        },
        "cwd": {
          "title": "Cwd",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "executable": {
          "title": "Executable",
          "type": "string"
        },
        "execution_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Id"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "network_mode": {
          "default": "none",
          "enum": [
            "none",
            "approved-unrestricted"
          ],
          "title": "Network Mode",
          "type": "string"
        },
        "output_truncated": {
          "title": "Output Truncated",
          "type": "boolean"
        },
        "principal_role": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Principal Role"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "sandbox_capabilities_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Capabilities Sha256"
        },
        "sandbox_configuration_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Configuration Sha256"
        },
        "sandbox_daemon_identity": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Daemon Identity"
        },
        "sandbox_id": {
          "anyOf": [
            {
              "pattern": "^sandbox_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Id"
        },
        "sandbox_image_identity": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Image Identity"
        },
        "sandbox_inspection_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Inspection Artifact Id"
        },
        "sandbox_inspection_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Inspection Sha256"
        },
        "sandbox_provider": {
          "title": "Sandbox Provider",
          "type": "string"
        },
        "sandbox_requirements_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Requirements Sha256"
        },
        "sandbox_security_level": {
          "$ref": "#/$defs/SandboxSecurityLevel"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "task_id": {
          "pattern": "^task_[0-9a-f]{32}$",
          "title": "Task Id",
          "type": "string"
        },
        "timed_out": {
          "title": "Timed Out",
          "type": "boolean"
        },
        "transcript_artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Transcript Artifact Id",
          "type": "string"
        },
        "workflow_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowStage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workspace_base_revision": {
          "title": "Workspace Base Revision",
          "type": "string"
        },
        "workspace_id": {
          "anyOf": [
            {
              "pattern": "^ws_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Id"
        },
        "workspace_kind": {
          "$ref": "#/$defs/WorkspaceKind",
          "default": "candidate"
        },
        "workspace_mutated_during_execution": {
          "default": false,
          "title": "Workspace Mutated During Execution",
          "type": "boolean"
        }
      },
      "required": [
        "evidence_id",
        "run_id",
        "task_id",
        "agent_instance_id",
        "executable",
        "argv",
        "cwd",
        "sandbox_provider",
        "sandbox_security_level",
        "strength",
        "exit_code",
        "timed_out",
        "output_truncated",
        "transcript_artifact_id",
        "workspace_base_revision",
        "config_snapshot_sha256",
        "started_at",
        "completed_at"
      ],
      "title": "CommandEvidence",
      "type": "object"
    },
    "CompletionDecision": {
      "additionalProperties": false,
      "properties": {
        "effective_verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "verified_complete": {
          "title": "Verified Complete",
          "type": "boolean"
        }
      },
      "required": [
        "verified_complete",
        "effective_verdict",
        "reason_codes"
      ],
      "title": "CompletionDecision",
      "type": "object"
    },
    "CriterionAssessment": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence_artifact_ids": {
          "items": {
            "pattern": "^art_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "criterion_id",
        "verdict",
        "explanation"
      ],
      "title": "CriterionAssessment",
      "type": "object"
    },
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "command_ids": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Command Ids",
          "type": "array"
        },
        "criterion_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence_artifact_ids": {
          "items": {
            "pattern": "^art_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "criterion_id",
        "verdict",
        "evidence_artifact_ids",
        "command_ids",
        "explanation"
      ],
      "title": "CriterionResult",
      "type": "object"
