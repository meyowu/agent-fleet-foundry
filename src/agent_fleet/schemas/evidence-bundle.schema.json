      "type": "string"
    },
    "ProofGap": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "required_strength": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceStrength"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "description"
      ],
      "title": "ProofGap",
      "type": "object"
    },
    "RemainingRisk": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "code",
        "description"
      ],
      "title": "RemainingRisk",
      "type": "object"
    },
