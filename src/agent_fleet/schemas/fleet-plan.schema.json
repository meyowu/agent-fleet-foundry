{
  "$defs": {
    "FleetPlanNode": {
      "additionalProperties": false,
      "properties": {
        "can_write": {
          "default": false,
          "title": "Can Write",
          "type": "boolean"
        },
        "depends_on": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Depends On",
          "type": "array"
        },
        "independent_verifier": {
          "default": false,
          "title": "Independent Verifier",
          "type": "boolean"
        },
        "max_steps": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "node_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "requires_workspace": {
          "default": false,
          "title": "Requires Workspace",
          "type": "boolean"
        },
        "role_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Role Id",
          "type": "string"
        },
        "scope": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Scope",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "role_id"
      ],
      "title": "FleetPlanNode",
      "type": "object"
    },
    "FleetStrategy": {
      "enum": [
        "direct",
        "single_engineer",
        "engineer_verifier",
        "parallel_engineers",
        "research_architect_engineer_verifier"
      ],
      "title": "FleetStrategy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "agentfleet.dev/v1alpha1",
      "default": "agentfleet.dev/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "kind": {
      "const": "FleetPlan",
      "default": "FleetPlan",
      "title": "Kind",
      "type": "string"
    },
    "max_parallel_agents": {
      "default": 1,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Parallel Agents",
      "type": "integer"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/FleetPlanNode"
      },
      "maxItems": 16,
      "title": "Nodes",
      "type": "array"
    },
    "plan_id": {
      "pattern": "^plan_[0-9a-f]{32}$",
      "title": "Plan Id",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "required_evidence": {
      "items": {
        "enum": [
          "canonical_patch",
          "command_evidence",
          "control_plane_plan",
          "independent_verifier_verdict"
        ],
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Required Evidence",
      "type": "array"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "strategy": {
      "$ref": "#/$defs/FleetStrategy"
    },
    "task_id": {
      "pattern": "^task_[0-9a-f]{32}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "run_id",
    "task_id",
    "strategy",
    "nodes",
    "required_evidence",
    "rationale",
    "created_at"
  ],
  "title": "FleetPlan",
  "type": "object"
}
