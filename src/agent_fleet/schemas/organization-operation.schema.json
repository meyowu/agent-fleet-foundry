{
  "$defs": {
    "DirectoryIdentity": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "minimum": 0,
          "title": "Device",
          "type": "integer"
        },
        "inode": {
          "exclusiveMinimum": 0,
          "title": "Inode",
          "type": "integer"
        },
        "mode": {
          "maximum": 4095,
          "minimum": 0,
          "title": "Mode",
          "type": "integer"
        },
        "uid": {
          "minimum": 0,
          "title": "Uid",
          "type": "integer"
        }
      },
      "required": [
        "device",
        "inode",
        "uid",
        "mode"
      ],
      "title": "DirectoryIdentity",
      "type": "object"
    },
    "OrganizationAdmission": {
      "additionalProperties": false,
      "properties": {
        "config_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Snapshot Sha256",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tree Sha256",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "revision",
        "tree_sha256",
        "config_snapshot_sha256"
      ],
      "title": "OrganizationAdmission",
      "type": "object"
    },
    "OrganizationRepositoryBoundary": {
      "additionalProperties": false,
      "properties": {
        "index_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Index Sha256",
          "type": "string"
        },
        "non_organization_status_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Non Organization Status Sha256",
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryInfo"
        }
      },
      "required": [
        "repository",
        "index_sha256",
        "non_organization_status_sha256"
      ],
      "title": "OrganizationRepositoryBoundary",
      "type": "object"
    },
    "PreparedPublication": {
      "additionalProperties": false,
      "properties": {
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        },
        "backend": {
          "enum": [
            "darwin-renameatx_np",
            "linux-renameat2"
          ],
          "title": "Backend",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "durability": {
          "enum": [
            "fsync+fullfsync",
            "fsync"
          ],
          "title": "Durability",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^fop_[0-9a-f]{32}$",
          "title": "Operation Id",
          "type": "string"
        },
        "parent_identity": {
          "$ref": "#/$defs/DirectoryIdentity"
        },
        "project_id": {
          "pattern": "^prj_[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "repository_basename": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Repository Basename",
          "type": "string"
        },
        "repository_directory_identity": {
          "$ref": "#/$defs/DirectoryIdentity"
        },
        "repository_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repository Identity",
          "type": "string"
        },
        "scratch_basename": {
          "pattern": "^\\.fleet-publication-fop_[0-9a-f]{32}$",
          "title": "Scratch Basename",
          "type": "string"
        },
        "scratch_identity": {
          "$ref": "#/$defs/DirectoryIdentity"
        },
        "staged_identity": {
          "$ref": "#/$defs/DirectoryIdentity"
        },
        "target_identity": {
          "$ref": "#/$defs/DirectoryIdentity"
        }
      },
      "required": [
        "operation_id",
        "project_id",
        "repository_identity",
        "repository_basename",
        "parent_identity",
        "repository_directory_identity",
        "target_identity",
        "scratch_basename",
        "scratch_identity",
        "staged_identity",
        "before_sha256",
        "after_sha256",
        "backend",
        "durability"
      ],
      "title": "PreparedPublication",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_canary_run_id": {
          "anyOf": [
            {
              "pattern": "^run_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bootstrap Canary Run Id"
        },
        "bootstrap_report_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bootstrap Report Artifact Id"
        },
        "bootstrap_report_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bootstrap Report Sha256"
        },
        "bootstrap_verified": {
          "default": false,
          "title": "Bootstrap Verified",
          "type": "boolean"
        },
        "canonical_root": {
          "title": "Canonical Root",
          "type": "string"
        },
        "config_snapshot_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Snapshot Artifact Id"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "credential_ref": {
          "anyOf": [
            {
              "maxLength": 132,
              "minLength": 5,
              "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "fleet_spec_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fleet Spec Hash"
        },
        "identity_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Hash",
          "type": "string"
        },
        "init_status_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Init Status Fingerprint"
        },
        "permission_scope_required": {
          "default": false,
          "title": "Permission Scope Required",
          "type": "boolean"
        },
        "project_id": {
          "pattern": "^prj_[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "project_knowledge_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Knowledge Artifact Id"
        },
        "project_knowledge_semantic_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Knowledge Semantic Hash"
        },
        "provider_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Model"
        },
        "remote_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Fingerprint"
        },
        "repository_profile_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Profile Artifact Id"
        },
        "repository_profile_semantic_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Profile Semantic Hash"
        },
        "runtime_name": {
          "default": "fake",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Runtime Name",
          "type": "string"
        },
        "sandbox_configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxConfiguration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sandbox_configuration_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Configuration Hash"
        },
        "sandbox_daemon_identity": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Daemon Identity"
        },
        "sandbox_image_identity": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox Image Identity"
        },
        "sandbox_name": {
          "default": "fake",
          "enum": [
            "fake",
            "docker",
            "local-unsafe"
          ],
          "title": "Sandbox Name",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "canonical_root",
        "identity_hash",
        "created_at",
        "updated_at"
      ],
      "title": "Project",
      "type": "object"
    },
    "RepositoryInfo": {
      "additionalProperties": false,
      "properties": {
        "dirty_paths": {
          "items": {
            "type": "string"
          },
          "title": "Dirty Paths",
          "type": "array"
        },
        "head_revision": {
          "title": "Head Revision",
          "type": "string"
        },
        "identity_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Hash",
          "type": "string"
        },
        "remote_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remote Fingerprint"
        },
        "root": {
          "title": "Root",
          "type": "string"
        },
        "status_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Status Fingerprint",
          "type": "string"
        },
        "status_porcelain": {
          "title": "Status Porcelain",
          "type": "string"
        }
      },
      "required": [
        "root",
        "head_revision",
        "remote_fingerprint",
        "identity_hash",
        "status_porcelain",
        "status_fingerprint",
        "dirty_paths"
      ],
      "title": "RepositoryInfo",
      "type": "object"
    },
    "SandboxConfiguration": {
      "additionalProperties": false,
      "properties": {
        "cpu_limit": {
          "default": 1.0,
          "maximum": 16,
          "minimum": 0.001,
          "multipleOf": 0.001,
          "title": "Cpu Limit",
          "type": "number"
        },
        "image": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "memory_mb": {
          "default": 512,
          "maximum": 32768,
          "minimum": 64,
          "title": "Memory Mb",
          "type": "integer"
        },
        "network_mode": {
          "default": "none",
          "enum": [
            "none",
            "approved-unrestricted"
          ],
          "title": "Network Mode",
          "type": "string"
        },
        "pids_limit": {
          "default": 128,
          "maximum": 4096,
          "minimum": 16,
          "title": "Pids Limit",
          "type": "integer"
        },
        "provider": {
          "default": "fake",
          "enum": [
            "fake",
            "docker",
            "local-unsafe"
          ],
          "title": "Provider",
          "type": "string"
        },
        "shm_mb": {
          "default": 64,
          "maximum": 1024,
          "minimum": 16,
          "title": "Shm Mb",
          "type": "integer"
        },
        "tmpfs_mb": {
          "default": 128,
          "maximum": 4096,
          "minimum": 16,
          "title": "Tmpfs Mb",
          "type": "integer"
        }
      },
      "title": "SandboxConfiguration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_event_id": {
      "pattern": "^evt_[0-9a-f]{32}$",
      "title": "Audit Event Id",
      "type": "string"
    },
    "authorization": {
      "enum": [
        "apply",
        "rollback"
      ],
      "title": "Authorization",
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/OrganizationAdmission"
    },
    "committed_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Committed Version"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^fop_[0-9a-f]{32}$",
      "title": "Operation Id",
      "type": "string"
    },
    "project_before": {
      "$ref": "#/$defs/Project"
    },
    "project_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Sha256",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^fpatch_[0-9a-f]{32}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Sha256",
      "type": "string"
    },
    "publication": {
      "$ref": "#/$defs/PreparedPublication"
    },
    "repository_before": {
      "$ref": "#/$defs/OrganizationRepositoryBoundary"
    },
    "status": {
      "enum": [
        "prepared",
        "committed",
        "aborted",
        "recovery_required"
      ],
      "title": "Status",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "proposal_id",
    "proposal_sha256",
    "base",
    "project_before",
    "project_sha256",
    "publication",
    "repository_before",
    "authorization",
    "status",
    "created_at",
    "updated_at",
    "audit_event_id"
  ],
  "title": "OrganizationOperation",
  "type": "object"
}
