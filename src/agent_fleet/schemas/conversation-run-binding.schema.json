{
  "$defs": {
    "RunBudgetLimits": {
      "additionalProperties": false,
      "properties": {
        "max_active_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Active Seconds",
          "type": "integer"
        },
        "max_agent_invocations": {
          "default": 64,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Agent Invocations",
          "type": "integer"
        },
        "max_model_requests": {
          "default": 128,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Model Requests",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 512,
          "maximum": 100000,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_total_tokens": {
          "default": 262144,
          "maximum": 100000000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        }
      },
      "title": "RunBudgetLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_limits": {
      "$ref": "#/$defs/RunBudgetLimits"
    },
    "config_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Snapshot Sha256",
      "type": "string"
    },
    "context_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Sha256",
      "type": "string"
    },
    "conversation_id": {
      "pattern": "^conv_[0-9a-f]{32}$",
      "title": "Conversation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9a-f]{32}$",
      "title": "Project Id",
      "type": "string"
    },
    "repository_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Identity",
      "type": "string"
    },
    "run_binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Binding Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "submission_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Submission Key",
      "type": "string"
    },
    "submission_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Submission Sha256",
      "type": "string"
    },
    "turn_id": {
      "pattern": "^turn_[0-9a-f]{32}$",
      "title": "Turn Id",
      "type": "string"
    },
    "user_goal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "User Goal Sha256",
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "turn_id",
    "project_id",
    "repository_identity",
    "sequence",
    "submission_key",
    "submission_sha256",
    "user_goal_sha256",
    "run_id",
    "run_binding_sha256",
    "config_snapshot_sha256",
    "budget_limits",
    "context_sha256",
    "created_at"
  ],
  "title": "ConversationRunBinding",
  "type": "object"
}
