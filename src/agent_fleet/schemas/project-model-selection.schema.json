{
  "additionalProperties": false,
  "properties": {
    "default_profile": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Profile"
    },
    "permitted_profiles": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Permitted Profiles",
      "type": "array"
    },
    "project_id": {
      "pattern": "^prj_[0-9a-f]{32}$",
      "title": "Project Id",
      "type": "string"
    },
    "repository_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Identity",
      "type": "string"
    },
    "revision": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "role_overrides": {
      "maxProperties": 64,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        }
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1
      },
      "title": "Role Overrides",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "repository_identity",
    "revision"
  ],
  "title": "ProjectModelSelection",
  "type": "object"
}
