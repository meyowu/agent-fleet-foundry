{
  "$defs": {
    "ModelRequestReservation": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "pattern": "^corr_[0-9a-f]{32}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "request_sequence": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Request Sequence",
          "type": "integer"
        },
        "requested_tokens": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Requested Tokens",
          "type": "integer"
        },
        "reserved_at": {
          "format": "date-time",
          "title": "Reserved At",
          "type": "string"
        },
        "token_allowance": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Token Allowance",
          "type": "integer"
        }
      },
      "required": [
        "attempt_id",
        "request_sequence",
        "token_allowance",
        "requested_tokens",
        "reserved_at"
      ],
      "title": "ModelRequestReservation",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "description": "Only provider-reported, provider-neutral usage facts.",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "maximum": 2000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "maximum": 2000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "provider_cost": {
          "anyOf": [
            {
              "maximum": 1000000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Cost"
        },
        "provider_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Currency"
        },
        "requests": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requests"
        },
        "tool_calls": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "total_tokens": {
          "anyOf": [
            {
              "maximum": 4000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "default": "reserved",
      "enum": [
        "reserved",
        "reported",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reservation": {
      "$ref": "#/$defs/ModelRequestReservation"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "reservation"
  ],
  "title": "ModelRequestAccounting",
  "type": "object"
}
