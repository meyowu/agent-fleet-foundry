            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Requests"
        },
        "output_tokens": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
