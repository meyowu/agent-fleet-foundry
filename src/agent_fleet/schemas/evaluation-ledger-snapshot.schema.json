        "campaign_id",
        "manifest_sha256",
        "case_id",
        "repetition",
        "attempt_id",
        "recorded_at",
        "configuration_sha256",
        "oracle_sha256",
        "scoring_sha256",
        "external_result",
        "apply_status"
      ],
      "title": "OutcomeRecord",
      "type": "object"
    },
    "OutcomeUsage": {
      "additionalProperties": false,
      "description": "One disjoint usage segment; None remains unreported, never zero.",
      "properties": {
        "active_milliseconds": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Milliseconds"
