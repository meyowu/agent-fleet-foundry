        "segment_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Segment Id",
          "type": "string"
        },
        "tool_calls": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "unknown_requests": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Unknown Requests",
          "type": "integer"
        }
      },
      "required": [
        "segment_id"
      ],
      "title": "OutcomeUsage",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "created",
        "running",
        "waiting_for_children",
        "paused_for_approval",
        "paused_for_plan",
        "ready_for_review",
        "applying",
        "completed",
        "failed",
        "cancelled",
        "rejected",
        "abandoned"
