          "title": "Case Id",
          "type": "string"
        },
        "commitment": {
          "$ref": "#/$defs/EvaluationRunBudget"
        },
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "idempotency_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Idempotency Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "repetition": {
          "maximum": 2,
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "reserved_at": {
          "format": "date-time",
          "title": "Reserved At",
          "type": "string"
        }
      },
      "required": [
        "campaign_id",
        "manifest_sha256",
        "case_id",
        "repetition",
        "attempt_id",
        "idempotency_sha256",
        "reserved_at",
        "commitment"
      ],
      "title": "EvaluationReservation",
      "type": "object"
    },
    "EvaluationRunBudget": {
      "additionalProperties": false,
      "properties": {
        "max_active_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Active Seconds",
          "type": "integer"
        },
        "max_agent_invocations": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Agent Invocations",
          "type": "integer"
        },
        "max_model_requests": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Model Requests",
          "type": "integer"
        },
        "max_tool_calls": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_total_tokens": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "max_agent_invocations",
        "max_model_requests",
        "max_tool_calls",
        "max_total_tokens",
        "max_active_seconds"
      ],
      "title": "EvaluationRunBudget",
      "type": "object"
    },
    "EvaluationSlot": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "repetition": {
          "maximum": 2,
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "repetition"
      ],
      "title": "EvaluationSlot",
      "type": "object"
    },
    "OutcomeArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "source_baseline",
            "patch",
            "verification",
            "apply",
            "post_apply",
            "oracle",
            "cleanup",
            "answer",
            "diagnostic"
          ],
          "title": "Category",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^run_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "category",
        "run_id",
        "sha256"
      ],
      "title": "OutcomeArtifactRef",
      "type": "object"
    },
    "OutcomeRecord": {
      "additionalProperties": false,
      "properties": {
        "apply_status": {
          "enum": [
            "applied",
            "not_applied",
            "failed",
            "not_applicable",
            "unknown"
          ],
          "title": "Apply Status",
          "type": "string"
        },
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OutcomeArtifactRef"
          },
          "maxItems": 64,
          "title": "Artifacts",
          "type": "array"
        },
        "attempt_id": {
          "pattern": "^attempt_[0-9a-f]{32}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "campaign_id": {
          "pattern": "^campaign_[0-9a-f]{32}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "external_result": {
          "enum": [
            "verified_success",
            "functional_failure",
            "environment_failure",
            "provider_failure",
            "budget_exhausted",
            "timeout",
            "cancelled",
            "inconclusive",
            "not_run",
            "dispatch_unknown"
          ],
          "title": "External Result",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "oracle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Oracle Sha256",
          "type": "string"
        },
        "outcome_id": {
          "pattern": "^outcome_[0-9a-f]{32}$",
          "title": "Outcome Id",
          "type": "string"
        },
        "product_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "product_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "product_verified_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Verified Complete"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "repetition": {
          "maximum": 2,
          "minimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "reported_cost_microunits": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Cost Microunits"
        },
        "root_run_id": {
          "anyOf": [
            {
              "pattern": "^run_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root Run Id"
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scoring_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scoring Sha256",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^task_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "usage": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OutcomeUsage"
          },
          "maxItems": 64,
          "title": "Usage",
          "type": "array"
        },
        "user_acceptance": {
          "default": "not_observed",
          "enum": [
            "accepted",
            "rejected",
            "not_observed"
          ],
          "title": "User Acceptance",
          "type": "string"
        }
      },
