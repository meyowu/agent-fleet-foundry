{
  "$defs": {
    "CampaignRegistration": {
      "additionalProperties": false,
      "properties": {
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
        },
        "manifest": {
          "$ref": "#/$defs/EvaluationManifest"
        },
        "registered_at": {
          "format": "date-time",
          "title": "Registered At",
          "type": "string"
        }
      },
      "required": [
        "manifest",
        "registered_at"
      ],
      "title": "CampaignRegistration",
      "type": "object"
    },
    "EvaluationCampaignBudget": {
      "additionalProperties": false,
      "properties": {
        "max_active_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Active Seconds",
          "type": "integer"
        },
        "max_agent_invocations": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Agent Invocations",
          "type": "integer"
        },
        "max_attempts": {
          "maximum": 256,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_model_requests": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Model Requests",
          "type": "integer"
        },
        "max_tool_calls": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_total_tokens": {
          "maximum": 100000000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "max_agent_invocations",
        "max_model_requests",
        "max_tool_calls",
        "max_total_tokens",
        "max_active_seconds",
        "max_attempts"
      ],
      "title": "EvaluationCampaignBudget",
      "type": "object"
    },
    "EvaluationCase": {
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Allowed Paths",
          "type": "array"
        },
        "auxiliary_purpose": {
          "anyOf": [
            {
              "enum": [
                "provider_canary",
                "cold_start",
                "safety"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Auxiliary Purpose"
        },
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/EvaluationCommand"
          },
          "maxItems": 32,
          "title": "Commands",
          "type": "array"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "dependencies_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependencies Sha256",
          "type": "string"
        },
        "image_identity": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Identity"
        },
        "oracle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Oracle Sha256",
          "type": "string"
        },
        "profile_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_revision": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Profile Revision",
          "type": "integer"
        },
        "profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profile Sha256",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Repository Id",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "enum": [
              "source_baseline",
              "patch",
              "verification",
              "apply",
              "post_apply",
              "oracle",
              "cleanup",
              "answer",
              "diagnostic"
            ],
            "type": "string"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Required Evidence",
          "type": "array"
        },
        "requirement": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        },
        "run_budget": {
          "$ref": "#/$defs/EvaluationRunBudget"
        },
        "scoring_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scoring Sha256",
          "type": "string"
        },
        "task_kind": {
          "enum": [
            "code_change",
            "read_only"
          ],
          "title": "Task Kind",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "repository_id",
        "task_kind",
        "requirement",
        "allowed_paths",
        "required_evidence",
        "oracle_sha256",
        "scoring_sha256",
        "commands",
        "image_identity",
        "dependencies_sha256",
        "profile_id",
        "profile_revision",
        "profile_sha256",
        "configuration_sha256",
        "run_budget"
      ],
      "title": "EvaluationCase",
      "type": "object"
    },
    "EvaluationCommand": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Command Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "sha256"
      ],
      "title": "EvaluationCommand",
      "type": "object"
    },
    "EvaluationCommitments": {
      "additionalProperties": false,
      "description": "Permanent reserved envelopes, not actual usage or monetary spend.",
      "properties": {
        "active_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Active Seconds",
          "type": "integer"
        },
        "agent_invocations": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Agent Invocations",
          "type": "integer"
        },
        "attempts": {
          "maximum": 256,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "model_requests": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Model Requests",
          "type": "integer"
        },
        "tool_calls": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "total_tokens": {
          "maximum": 100000000,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        }
      },
      "required": [
        "attempts",
        "agent_invocations",
        "model_requests",
        "tool_calls",
        "total_tokens",
        "active_seconds"
      ],
      "title": "EvaluationCommitments",
      "type": "object"
    },
    "EvaluationManifest": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/EvaluationCampaignBudget"
        },
        "campaign_id": {
          "pattern": "^campaign_[0-9a-f]{32}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/EvaluationCase"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "manifest_id": {
          "pattern": "^eval_[0-9a-f]{32}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "previous_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Sha256"
        },
        "repositories": {
          "items": {
            "$ref": "#/$defs/EvaluationRepository"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Repositories",
          "type": "array"
        },
        "revision": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/EvaluationSlot"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Slots",
          "type": "array"
        }
      },
      "required": [
        "manifest_id",
        "campaign_id",
        "revision",
        "frozen_at",
        "repositories",
        "cases",
        "slots",
        "budget"
      ],
      "title": "EvaluationManifest",
      "type": "object"
    },
    "EvaluationRepository": {
      "additionalProperties": false,
      "properties": {
        "cohort": {
          "enum": [
            "development",
            "sealed_holdout",
            "auxiliary"
          ],
          "title": "Cohort",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Commit Sha",
          "type": "string"
        },
        "repository_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Repository Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "source_sha256",
        "commit_sha",
        "cohort"
      ],
      "title": "EvaluationRepository",
      "type": "object"
    },
    "EvaluationReservation": {
