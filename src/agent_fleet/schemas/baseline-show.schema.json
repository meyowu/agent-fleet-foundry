{
  "$defs": {
    "BaselineCanonicalSnapshot": {
      "additionalProperties": false,
      "properties": {
        "canonical_json": {
          "title": "Canonical Json",
          "type": "string"
        },
        "schema_tag": {
          "enum": [
            "command-v1",
            "sandbox-spec-v1",
            "sandbox-policy-v1",
            "sandbox-inspection-v1",
            "capabilities-v1",
            "configuration-v1",
            "requirements-v1",
            "source-manifest-v1",
            "native-handle-v1",
            "cleanup-v1"
          ],
          "title": "Schema Tag",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_tag",
        "canonical_json",
        "sha256"
      ],
      "title": "BaselineCanonicalSnapshot",
      "type": "object"
    },
    "BaselineCommandObservation": {
      "additionalProperties": false,
      "properties": {
        "approved_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Source Sha256",
          "type": "string"
        },
        "authorization_id": {
          "pattern": "^bauth_[0-9a-f]{32}$",
          "title": "Authorization Id",
          "type": "string"
        },
        "baseline_id": {
          "pattern": "^baseline_[0-9a-f]{32}$",
          "title": "Baseline Id",
          "type": "string"
        },
        "cancelled": {
          "title": "Cancelled",
          "type": "boolean"
        },
        "capture_truncated": {
          "title": "Capture Truncated",
          "type": "boolean"
        },
        "claim_id": {
          "pattern": "^bclaim_[0-9a-f]{32}$",
          "title": "Claim Id",
          "type": "string"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "decoding_replaced": {
          "title": "Decoding Replaced",
          "type": "boolean"
        },
        "execution_id": {
          "pattern": "^bexec_[0-9a-f]{32}$",
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "inspection": {
          "$ref": "#/$defs/BaselineCanonicalSnapshot"
        },
        "materialized_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Materialized Source Sha256",
          "type": "string"
        },
        "native_handle": {
          "$ref": "#/$defs/BaselineCanonicalSnapshot"
        },
        "post_source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Post Source Sha256"
        },
        "project_id": {
          "pattern": "^prj_[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "redaction_truncated": {
          "title": "Redaction Truncated",
          "type": "boolean"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "review_id": {
          "pattern": "^breview_[0-9a-f]{32}$",
          "title": "Review Id",
          "type": "string"
        },
        "review_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Sha256",
          "type": "string"
        },
        "sandbox_id": {
          "pattern": "^bsandbox_[0-9a-f]{32}$",
          "title": "Sandbox Id",
          "type": "string"
        },
        "sandbox_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Policy Sha256",
          "type": "string"
        },
        "sandbox_spec_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Spec Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "stderr": {
          "maxLength": 64000,
          "title": "Stderr",
          "type": "string"
        },
        "stderr_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stderr Sha256",
          "type": "string"
        },
        "stdout": {
          "maxLength": 64000,
          "title": "Stdout",
          "type": "string"
        },
        "stdout_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stdout Sha256",
          "type": "string"
        },
        "timed_out": {
          "title": "Timed Out",
          "type": "boolean"
        },
        "workspace_id": {
          "pattern": "^bws_[0-9a-f]{32}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "baseline_id",
        "project_id",
        "review_id",
        "review_sha256",
        "authorization_id",
        "claim_id",
        "execution_id",
        "workspace_id",
        "sandbox_id",
        "command_sha256",
        "sandbox_policy_sha256",
        "sandbox_spec_sha256",
        "request_sha256",
        "approved_source_sha256",
        "materialized_source_sha256",
        "post_source_sha256",
        "native_handle",
        "inspection",
        "started_at",
        "completed_at",
        "exit_code",
        "timed_out",
        "cancelled",
        "capture_truncated",
        "redaction_truncated",
        "decoding_replaced",
        "stdout",
        "stderr",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "title": "BaselineCommandObservation",
      "type": "object"
    },
    "BaselineExecution": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "pattern": "^baseline_[0-9a-f]{32}$",
          "title": "Baseline Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "current_report_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Report Sha256"
        },
        "owner_claim_id": {
          "anyOf": [
            {
              "pattern": "^bclaim_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Claim Id"
        },
        "project_id": {
          "pattern": "^prj_[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "review_id": {
          "pattern": "^breview_[0-9a-f]{32}$",
          "title": "Review Id",
          "type": "string"
        },
        "review_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Sha256",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "planned",
            "revoked",
            "owned",
            "executing",
            "cleaning",
            "observed",
            "inconclusive",
            "recovery_required"
          ],
          "title": "Status",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "baseline_id",
        "review_id",
        "review_sha256",
        "project_id",
        "revision",
        "status",
        "created_at",
        "updated_at"
      ],
      "title": "BaselineExecution",
      "type": "object"
    },
    "BaselineObservationRef": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "pattern": "^baseline_[0-9a-f]{32}$",
          "title": "Baseline Id",
          "type": "string"
        },
        "execution_id": {
          "pattern": "^bexec_[0-9a-f]{32}$",
          "title": "Execution Id",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^bobs_[0-9a-f]{64}$",
          "title": "Observation Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "baseline_id",
        "execution_id",
        "record_sha256"
      ],
      "title": "BaselineObservationRef",
      "type": "object"
    },
    "BaselineReport": {
      "additionalProperties": false,
      "properties": {
        "approved_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Source Sha256",
          "type": "string"
        },
        "authorization_id": {
          "pattern": "^bauth_[0-9a-f]{32}$",
          "title": "Authorization Id",
          "type": "string"
        },
        "baseline_id": {
          "pattern": "^baseline_[0-9a-f]{32}$",
          "title": "Baseline Id",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^bclaim_[0-9a-f]{32}$",
          "title": "Claim Id",
          "type": "string"
        },
        "cleanup_complete": {
          "title": "Cleanup Complete",
          "type": "boolean"
        },
        "cleanup_receipt_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Cleanup Receipt Sha256S",
          "type": "array"
        },
        "cleanup_scope_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cleanup Scope Sha256",
          "type": "string"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "completion_assurance": {
          "const": "baseline_observation_only",
          "default": "baseline_observation_only",
          "title": "Completion Assurance",
          "type": "string"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineObservationRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_exit_code": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed Exit Code"
        },
        "predecessor_report_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Report Sha256"
        },
        "project_id": {
          "pattern": "^prj_[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "proof_gaps": {
          "items": {
            "enum": [
              "missing_result",
              "output_incomplete",
              "source_drift",
              "cleanup_incomplete",
              "controller_error"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Proof Gaps",
          "type": "array"
        },
        "review_id": {
          "pattern": "^breview_[0-9a-f]{32}$",
          "title": "Review Id",
          "type": "string"
        },
        "review_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "observed",
            "inconclusive",
            "recovery_required"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_applied": {
          "const": false,
          "default": false,
          "title": "Target Applied",
          "type": "boolean"
        }
      },
      "required": [
        "baseline_id",
        "project_id",
        "review_id",
        "review_sha256",
        "authorization_id",
        "claim_id",
        "command_sha256",
        "approved_source_sha256",
        "observation",
        "cleanup_scope_sha256",
        "cleanup_receipt_sha256s",
        "cleanup_complete",
        "status",
        "observed_exit_code",
        "completed_at",
        "proof_gaps"
      ],
      "title": "BaselineReport",
      "type": "object"
    },
    "BaselineReview": {
      "additionalProperties": false,
      "properties": {
        "approved_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approved Source Sha256",
          "type": "string"
        },
        "base_revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Base Revision",
          "type": "string"
        },
        "baseline_id": {
          "pattern": "^baseline_[0-9a-f]{32}$",
          "title": "Baseline Id",
          "type": "string"
        },
        "capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineCanonicalSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "$ref": "#/$defs/BaselineCanonicalSnapshot"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "installation_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Installation Id",
          "type": "string"
        },
        "max_attempt_seconds": {
          "default": 300,
          "maximum": 300,
          "minimum": 1,
          "title": "Max Attempt Seconds",
          "type": "integer"
        },
        "project_id": {
          "pattern": "^prj_[0-9a-f]{32}$",
          "title": "Project Id",
          "type": "string"
        },
        "project_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Project Sha256",
          "type": "string"
        },
        "reason": {
          "enum": [
            "ready",
            "sandbox_unavailable",
            "image_unavailable",
            "capability_missing"
          ],
          "title": "Reason",
          "type": "string"
        },
        "repository_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repository Identity Sha256",
          "type": "string"
        },
        "repository_root": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Repository Root",
          "type": "string"
        },
        "repository_state_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repository State Sha256",
          "type": "string"
        },
        "review_id": {
          "pattern": "^breview_[0-9a-f]{32}$",
          "title": "Review Id",
          "type": "string"
        },
        "sandbox_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineCanonicalSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_scope": {
          "const": "whole_committed_tree",
          "default": "whole_committed_tree",
          "title": "Source Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "not_ready"
          ],
          "title": "Status",
          "type": "string"
        },
        "trust_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trust Policy Sha256",
          "type": "string"
        },
        "trust_revision": {
          "minimum": 0,
          "title": "Trust Revision",
          "type": "integer"
        }
      },
      "required": [
        "review_id",
        "baseline_id",
        "project_id",
        "project_sha256",
        "repository_identity_sha256",
        "repository_root",
        "base_revision",
        "repository_state_sha256",
        "approved_source_sha256",
        "configuration_sha256",
        "trust_policy_sha256",
        "trust_revision",
        "command",
        "sandbox_policy",
        "capabilities",
        "installation_id",
        "status",
        "reason",
        "created_at",
        "expires_at"
      ],
      "title": "BaselineReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution": {
      "$ref": "#/$defs/BaselineExecution"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineCommandObservation"
        },
        {
          "type": "null"
        }
      ]
    },
    "recovery_scope_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recovery Scope Sha256"
    },
    "report": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineReport"
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "$ref": "#/$defs/BaselineReview"
    }
  },
  "required": [
    "review",
    "execution",
    "report",
    "observation",
    "recovery_scope_sha256"
  ],
  "title": "BaselineShow",
  "type": "object"
}
