{
  "$defs": {
    "AgentLifecycle": {
      "enum": [
        "persistent",
        "per_task"
      ],
      "title": "AgentLifecycle",
      "type": "string"
    },
    "AgentRequest": {
      "additionalProperties": false,
      "properties": {
        "allowedTools": {
          "items": {
            "type": "string"
          },
          "title": "Allowedtools",
          "type": "array"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/AgentLifecycle"
        },
        "maxSteps": {
          "maximum": 100,
          "minimum": 1,
          "title": "Maxsteps",
          "type": "integer"
        },
        "mayDelegateTo": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Maydelegateto",
          "type": "array"
        },
        "role": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "lifecycle",
        "instructions",
        "allowedTools",
        "maxSteps"
      ],
      "title": "AgentRequest",
      "type": "object"
    },
    "FleetSpecBody": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
              "$ref": "#/$defs/AgentRequest"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Agents",
          "type": "object"
        },
        "project": {
          "$ref": "#/$defs/ProjectFiles"
        },
        "requestedPermissions": {
          "items": {
            "$ref": "#/$defs/RequestedPermission"
          },
          "title": "Requestedpermissions",
          "type": "array"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeRequest"
        },
        "sandbox": {
          "$ref": "#/$defs/SandboxRequest"
        },
        "workflows": {
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
              "$ref": "#/$defs/WorkflowRequest"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Workflows",
          "type": "object"
        }
      },
      "required": [
        "runtime",
        "sandbox",
        "agents",
        "workflows",
        "project",
        "requestedPermissions"
      ],
      "title": "FleetSpecBody",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "ProjectFiles": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "title": "Architecture",
          "type": "string"
        },
        "charter": {
          "title": "Charter",
          "type": "string"
        },
        "verification": {
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "charter",
        "architecture",
        "verification"
      ],
      "title": "ProjectFiles",
      "type": "object"
    },
    "RequestedPermission": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Action",
          "type": "string"
        },
        "principalRole": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Principalrole",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        }
      },
      "required": [
        "principalRole",
        "action",
        "resource"
      ],
      "title": "RequestedPermission",
      "type": "object"
    },
    "RuntimeCapability": {
      "enum": [
        "structured_output",
        "tool_calling",
        "streaming",
        "checkpoint",
        "resume",
        "usage_accounting"
      ],
      "title": "RuntimeCapability",
      "type": "string"
    },
    "RuntimeRequest": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "fake"
              }
            },
            "required": [
              "adapter"
            ]
          },
          "then": {
            "properties": {
              "providerModel": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "adapter": {
                "enum": [
                  "pydantic-ai",
                  "openai-agents",
                  "langgraph"
                ]
              }
            },
            "required": [
              "adapter"
            ]
          },
          "then": {
            "properties": {
              "providerModel": {
                "type": "string"
              }
            },
            "required": [
              "providerModel"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "adapter": {
                "enum": [
                  "openai-agents",
                  "langgraph"
                ]
              }
            },
            "required": [
              "adapter"
            ]
          },
          "then": {
            "properties": {
              "providerModel": {
                "pattern": "^openai:"
              }
            }
          }
        }
      ],
      "properties": {
        "adapter": {
          "enum": [
            "fake",
            "pydantic-ai",
            "openai-agents",
            "langgraph"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "providerModel": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providermodel"
        },
        "requiredCapabilities": {
          "allOf": [
            {
              "contains": {
                "const": "structured_output"
              }
            },
            {
              "contains": {
                "const": "tool_calling"
              }
            }
          ],
          "items": {
            "$ref": "#/$defs/RuntimeCapability"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Requiredcapabilities",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "adapter",
        "requiredCapabilities"
      ],
      "title": "RuntimeRequest",
      "type": "object"
    },
    "SandboxRequest": {
      "additionalProperties": false,
      "properties": {
        "cpuLimit": {
          "default": 1.0,
          "maximum": 16,
          "minimum": 0.001,
          "multipleOf": 0.001,
          "title": "Cpulimit",
          "type": "number"
        },
        "image": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "memoryMb": {
          "default": 512,
          "maximum": 32768,
          "minimum": 64,
          "title": "Memorymb",
          "type": "integer"
        },
        "networkMode": {
          "enum": [
            "none",
            "approved-unrestricted"
          ],
          "title": "Networkmode",
          "type": "string"
        },
        "pidsLimit": {
          "default": 128,
          "maximum": 4096,
          "minimum": 16,
          "title": "Pidslimit",
          "type": "integer"
        },
        "provider": {
          "enum": [
            "fake",
            "docker",
            "local-unsafe"
          ],
          "title": "Provider",
          "type": "string"
        },
        "shmMb": {
          "default": 64,
          "maximum": 1024,
          "minimum": 16,
          "title": "Shmmb",
          "type": "integer"
        },
        "tmpfsMb": {
          "default": 128,
          "maximum": 4096,
          "minimum": 16,
          "title": "Tmpfsmb",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "networkMode"
      ],
      "title": "SandboxRequest",
      "type": "object"
    },
    "WorkflowRequest": {
      "additionalProperties": false,
      "properties": {
        "allowedTools": {
          "anyOf": [
            {
              "items": {
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_.-]*$",
                "type": "string"
              },
              "maxItems": 64,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowedtools"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "maxParallelAgents": {
          "default": 2,
          "maximum": 8,
          "minimum": 1,
          "title": "Maxparallelagents",
          "type": "integer"
        },
        "maxRepairIterations": {
          "maximum": 5,
          "minimum": 0,
          "title": "Maxrepairiterations",
          "type": "integer"
        }
      },
      "required": [
        "definition",
        "maxRepairIterations"
      ],
      "title": "WorkflowRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "agentfleet.dev/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "Fleet",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/FleetSpecBody"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "FleetSpec",
  "type": "object"
}
