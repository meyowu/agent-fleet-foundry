      "required": [
        "name",
        "purpose",
        "executable",
        "argv",
        "cwd",
        "provenance",
        "confidence"
      ],
      "title": "RepositoryCommand",
      "type": "object"
    },
    "RepositorySignal": {
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "enum": [
            "python",
            "node",
            "go",
            "rust",
            "maven",
            "gradle",
            "make",
            "github-actions"
          ],
          "title": "Ecosystem",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "signal": {
          "title": "Signal",
          "type": "string"
        }
      },
      "required": [
        "ecosystem",
        "path",
        "signal"
