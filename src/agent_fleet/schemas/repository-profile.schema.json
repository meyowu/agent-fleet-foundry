      },
      "title": "Commands",
      "type": "array"
    },
    "ecosystems": {
      "items": {
        "enum": [
          "python",
          "node",
          "go",
          "rust",
          "maven",
          "gradle",
          "make",
          "github-actions"
        ],
        "type": "string"
      },
      "title": "Ecosystems",
      "type": "array"
    },
    "files_read": {
      "items": {
        "type": "string"
      },
      "title": "Files Read",
      "type": "array"
    },
    "root": {
      "const": ".",
      "default": ".",
      "title": "Root",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
