        "name": {
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/CommandProvenance"
        },
        "purpose": {
          "enum": [
            "test",
            "lint",
            "build",
            "check",
            "other"
