    "CommandProvenance": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "path",
        "source"
      ],
      "title": "CommandProvenance",
      "type": "object"
    },
    "RepositoryAmbiguity": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RepositoryAmbiguity",
      "type": "object"
    },
