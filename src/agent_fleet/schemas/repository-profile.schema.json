          "type": "string"
        },
        "cwd": {
          "title": "Cwd",
          "type": "string"
        },
        "executable": {
          "title": "Executable",
          "type": "string"
        },
        "execution_authorized": {
          "const": false,
          "default": false,
          "title": "Execution Authorized",
          "type": "boolean"
