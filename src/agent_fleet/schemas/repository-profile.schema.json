        "path",
        "ecosystems",
        "manifests"
      ],
      "title": "RepositoryBoundary",
      "type": "object"
    },
    "RepositoryCommand": {
      "additionalProperties": false,
      "description": "An untrusted command candidate; detection is never authorization.",
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
