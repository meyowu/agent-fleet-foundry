{
  "$defs": {
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "command_ids": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Command Ids",
          "type": "array"
        },
        "criterion_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence_artifact_ids": {
          "items": {
            "pattern": "^art_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Artifact Ids",
          "type": "array"
        },
        "explanation": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "criterion_id",
        "verdict",
        "evidence_artifact_ids",
        "command_ids",
        "explanation"
      ],
      "title": "CriterionResult",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "criterion_results": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "title": "Criterion Results",
      "type": "array"
    },
    "evidence_artifact_ids": {
      "items": {
        "pattern": "^art_[0-9a-f]{32}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Artifact Ids",
      "type": "array"
    },
    "proof_gaps": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "title": "Proof Gaps",
      "type": "array"
    },
    "rationale": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "regressions": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "title": "Regressions",
      "type": "array"
    },
    "required_repairs": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "title": "Required Repairs",
      "type": "array"
    },
    "structured_criterion_results": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CriterionResult"
          },
          "maxItems": 128,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structured Criterion Results"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "verdict",
    "criterion_results",
    "evidence_artifact_ids",
    "regressions",
    "required_repairs",
    "proof_gaps",
    "rationale"
  ],
  "title": "VerifierVerdict",
  "type": "object"
}
