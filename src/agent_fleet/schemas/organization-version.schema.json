{
  "additionalProperties": false,
  "properties": {
    "audit_event_id": {
      "pattern": "^evt_[0-9a-f]{32}$",
      "title": "Audit Event Id",
      "type": "string"
    },
    "config_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Snapshot Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "operation_id": {
      "anyOf": [
        {
          "pattern": "^fop_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "predecessor_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Sha256"
    },
    "predecessor_version": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predecessor Version"
    },
    "project_id": {
      "pattern": "^prj_[0-9a-f]{32}$",
      "title": "Project Id",
      "type": "string"
    },
    "project_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Sha256",
      "type": "string"
    },
    "tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tree Sha256",
      "type": "string"
    },
    "version": {
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "version",
    "tree_sha256",
    "config_snapshot_sha256",
    "project_sha256",
    "created_at",
    "audit_event_id"
  ],
  "title": "OrganizationVersion",
  "type": "object"
}
