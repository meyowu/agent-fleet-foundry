{
  "$defs": {
    "ResolvedModelBinding": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/RuntimeConfiguration"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "profile_name": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Name"
        },
        "profile_revision": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Revision"
        },
        "role_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Role Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "override",
            "repository_preference",
            "default",
            "legacy"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "role_id",
        "source",
        "configuration",
        "configuration_sha256"
      ],
      "title": "ResolvedModelBinding",
      "type": "object"
    },
    "RuntimeConfiguration": {
      "additionalProperties": false,
      "description": "Provider-neutral, trusted runtime selection and invocation ceilings.",
      "properties": {
        "credential_ref": {
          "anyOf": [
            {
              "maxLength": 132,
              "minLength": 5,
              "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "max_requests": {
          "default": 8,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_retries": {
          "default": 1,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 32,
          "maximum": 256,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_total_tokens": {
          "default": 32768,
          "maximum": 2000000,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "provider_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Model"
        },
        "runtime_name": {
          "default": "fake",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]*$",
          "title": "Runtime Name",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "RuntimeConfiguration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9a-f]{32}$",
      "title": "Project Id",
      "type": "string"
    },
    "repository_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Identity",
      "type": "string"
    },
    "roles": {
      "maxProperties": 64,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_-]*$": {
          "$ref": "#/$defs/ResolvedModelBinding"
        }
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1
      },
      "title": "Roles",
      "type": "object"
    },
    "root_run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Root Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selection_revision": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection Revision"
    }
  },
  "required": [
    "root_run_id",
    "project_id",
    "repository_identity",
    "created_at",
    "roles"
  ],
  "title": "RunModelBindings",
  "type": "object"
}
