{
  "$defs": {
    "BaselineCanonicalSnapshot": {
      "additionalProperties": false,
      "properties": {
        "canonical_json": {
          "title": "Canonical Json",
          "type": "string"
        },
        "schema_tag": {
          "enum": [
            "command-v1",
            "sandbox-spec-v1",
            "sandbox-policy-v1",
            "sandbox-inspection-v1",
            "capabilities-v1",
            "configuration-v1",
            "requirements-v1",
            "source-manifest-v1",
            "native-handle-v1",
            "cleanup-v1"
          ],
          "title": "Schema Tag",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "schema_tag",
        "canonical_json",
        "sha256"
      ],
      "title": "BaselineCanonicalSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approved_source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approved Source Sha256",
      "type": "string"
    },
    "base_revision": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Base Revision",
      "type": "string"
    },
    "baseline_id": {
      "pattern": "^baseline_[0-9a-f]{32}$",
      "title": "Baseline Id",
      "type": "string"
    },
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineCanonicalSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "command": {
      "$ref": "#/$defs/BaselineCanonicalSnapshot"
    },
    "configuration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "installation_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Installation Id",
      "type": "string"
    },
    "max_attempt_seconds": {
      "default": 300,
      "maximum": 300,
      "minimum": 1,
      "title": "Max Attempt Seconds",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^prj_[0-9a-f]{32}$",
      "title": "Project Id",
      "type": "string"
    },
    "project_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Project Sha256",
      "type": "string"
    },
    "reason": {
      "enum": [
        "ready",
        "sandbox_unavailable",
        "image_unavailable",
        "capability_missing"
      ],
      "title": "Reason",
      "type": "string"
    },
    "repository_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository Identity Sha256",
      "type": "string"
    },
    "repository_root": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Repository Root",
      "type": "string"
    },
    "repository_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repository State Sha256",
      "type": "string"
    },
    "review_id": {
      "pattern": "^breview_[0-9a-f]{32}$",
      "title": "Review Id",
      "type": "string"
    },
    "sandbox_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineCanonicalSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_scope": {
      "const": "whole_committed_tree",
      "default": "whole_committed_tree",
      "title": "Source Scope",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "not_ready"
      ],
      "title": "Status",
      "type": "string"
    },
    "trust_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Trust Policy Sha256",
      "type": "string"
    },
    "trust_revision": {
      "minimum": 0,
      "title": "Trust Revision",
      "type": "integer"
    }
  },
  "required": [
    "review_id",
    "baseline_id",
    "project_id",
    "project_sha256",
    "repository_identity_sha256",
    "repository_root",
    "base_revision",
    "repository_state_sha256",
    "approved_source_sha256",
    "configuration_sha256",
    "trust_policy_sha256",
    "trust_revision",
    "command",
    "sandbox_policy",
    "capabilities",
    "installation_id",
    "status",
    "reason",
    "created_at",
    "expires_at"
  ],
  "title": "BaselineReview",
  "type": "object"
}
